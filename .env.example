# MotoVerse environment configuration
# Copy to `.env` (kept out of version control) and fill in real values.
# Loaded at build time via --dart-define-from-file=.env or individual --dart-define flags.

SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key

# Google Maps (Service Centers, Roadside Assistance)
GOOGLE_MAPS_API_KEY=your-google-maps-key

# Optional: environment name (development | staging | production)
APP_ENV=development
